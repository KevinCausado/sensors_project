{
  "name": "vibrai-backend",
  "version": "1.0.0",
  "main": "start.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node start.js",
    "test": "echo \"Run specific tests with npm run test:<name>\"",
    "test:complete": "node tests/test-complete-processing.js",
    "test:temperature": "node tests/test-temperature-conversion.js",
    "test:timestamps": "node tests/test-timestamp-consistency.js",
    "test:batch": "node tests/test-batch-insertion.js",
    "test:performance": "node tests/performance-comparison.js",
    "test:monitor": "node tests/monitor-real-timestamps.js",
    "test:sensor": "node tests/get-real-sensor.js",
    "test:mqtt-simulator": "node tests/test-mqtt-payload-simulator.js",
    "test:mqtt-analyzer": "node tests/test-mqtt-real-analyzer.js",
    "test:all": "npm run test:complete && npm run test:temperature && npm run test:timestamps && npm run test:batch",
    "simulator": "node mqtt-simulator.js",
    "analyzer": "node tests/test-mqtt-real-analyzer.js"
  },
  "keywords": ["iot", "mqtt", "vibration", "temperature", "monitoring", "supabase"],
  "author": "Vibrai Team",
  "license": "ISC",
  "description": "Sistema backend para monitoreo IoT de sensores de vibración y temperatura",
  "dependencies": {
    "@supabase/supabase-js": "^2.50.3",
    "dotenv": "^16.6.1",
    "lodash": "^4.17.21",
    "mqtt": "^5.13.1"
  }
}
